# Copy to .env in each backend folder (never commit .env). Same values in both backends.
MONGODB_URI=mongodb://localhost:27017/recipebook
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 1 = fake uploads (no Cloudinary calls). The contract tests set this themselves.
CLOUDINARY_FAKE=0
# Express only
PORT=5000
